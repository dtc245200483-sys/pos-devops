# ========================================================
# POS System Environment Configuration (Example)
# ========================================================

# Application Settings
APP_NAME="POS Store Management"
APP_ENV=production
APP_DEBUG=false
APP_KEY=change_this_to_a_secure_random_key_min16chars
APP_URL=https://192.168.47.128

# Database Settings (MySQL 8)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pos_db
DB_USERNAME=pos_user
DB_PASSWORD=change_this_pos_password_min16chars
MYSQL_ROOT_PASSWORD=change_this_root_password_min16chars

# phpMyAdmin
PMA_PORT=8080

# Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_min16chars
