{
  "id": null,
  "uid": "pos-mysql",
  "title": "POS - MySQL",
  "tags": [
    "pos",
    "mysql",
    "db"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "MySQL Queries / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries[1m])",
          "legendFormat": "Queries/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Threads Connected vs Running",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "Connected"
        },
        {
          "expr": "mysql_global_status_threads_running",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Client Connections / sec",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "expr": "rate(mysql_global_status_connections[1m])",
          "legendFormat": "Connections/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    },
    {
      "id": 4,
      "title": "InnoDB Buffer Pool (Data vs Free)",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "expr": "mysql_global_status_innodb_buffer_pool_bytes_data",
          "legendFormat": "Data Bytes"
        },
        {
          "expr": "mysql_global_status_buffer_pool_pages{state=\"free\"} * on(instance, job) mysql_global_status_innodb_page_size",
          "legendFormat": "Free Bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line"
          }
        }
      }
    }
  ]
}